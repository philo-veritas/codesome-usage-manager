# Copy to config.yaml and fill in real credentials locally.
# config.yaml, auth/cache JSON files, and SQLite DB files are intentionally ignored by git.
codesome:
  base_url: "https://v3.codesome.cn"
  login:
    email: "your-email@example.com"
    password: "your-password"
  default_group_id: 51
  # Legacy only: keep api_key_ids when you need old alias-based commands,
  # or run `codesome db import-config-keys` as a fallback when remote import is unavailable.
  # Prefer `codesome db import-remote-keys` for new SQLite bootstraps.
  # api_key_ids:
  #   - id: 6732
  #     name: "main"
  #     key: "main"

feishu:
  # Used by both Bitable import and direct-message delivery.
  app_id: "cli_xxx"
  app_secret: "your-feishu-app-secret"
  bitable:
    app_token: "bascn_xxx"
    users:
      table_id: "tblxxx"
      # Optional: limit import/explore to a specific Bitable view.
      # view_id: "vewxxx"
      # The user table parser expects these Bitable fields:
      # 人员: person field; uses [0].name and [0].id
      # 工号: rich text/number-like field; uses value[0].text
      # 团队: text field; uses [0].text
      # 状态: option/text field; maps 生效->active, 禁用->inactive
    usage:
      # table_id: "tblusagexxx"
      # Optional: restrict fallback ID lookup to a view; prefer a full usage view.
      # view_id: "vewusagexxx"
      # Usage sync writes: ID, 日期, 人员, 总Tokens, 实际成本USD.

database:
  # Keep this path aligned with Docker volume mounts if you deploy with compose.
  path: "./codesome-manager.db"
